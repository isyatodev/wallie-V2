[TEMPLATE]
# ============ LLM Providers ============
# At least one must be set. Select active one via "llm.provider" in config.yaml.
OPENAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Generic OpenAI-compatible endpoint (llm.provider: openai_compatible).
# Base URL + model are set in the profile/dashboard (Engine section); the key lives here.
# Base URL must include the version path, e.g. https://api.openai.com/v1,
# https://openrouter.ai/api/v1, https://api.groq.com/openai/v1 — or your own gateway.
OPENAI_COMPATIBLE_API_KEY=

# Dedicated OpenAI-compatible blocks per subsystem (all optional):
# VISION - separate vision model (e.g. qwen-vl) while the brain stays on another provider.
#          Enable in Engine -> Vision block (base URL + model live in the profile).
OPENAI_COMPATIBLE_VISION_API_KEY=
# TTS - speech gateway implementing POST {base}/audio/speech (OpenAI, Kokoro-FastAPI, ...).
#        Select provider "openai_compatible" in Voice; base URL + model/voice live in the profile.
OPENAI_COMPATIBLE_TTS_API_KEY=
# STT - transcription gateway implementing POST {base}/audio/transcriptions (OpenAI, Groq, ...).
#        Set Hearing -> engine = openai_compatible; base URL + model live in the profile.
OPENAI_COMPATIBLE_STT_API_KEY=

# Memory-extraction model (Memory -> Extraction model = OpenAI-Compatible).
#        Base URL + model live in the profile (Memory section).
OPENAI_COMPATIBLE_MEMORY_API_KEY=

# Spontaneous-thought generator (Memory -> Thought generator = OpenAI-Compatible).
OPENAI_COMPATIBLE_THOUGHTS_API_KEY=

# ============ TTS Providers ============
# Key is only required for the provider selected in config.yaml.
FISH_API_KEY=
ELEVENLABS_API_KEY=

# ============ Stream Platforms ============
# YouTube: Google OAuth (place client_secret.json under scripts/)
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_SECRET_FILE=scripts/client_secret.json
YOUTUBE_LIVE_CHAT_ID=

# Twitch: oauth token from https://twitchtokengenerator.com
TWITCH_OAUTH_TOKEN=
TWITCH_CHANNEL=
TWITCH_NICK=

# Kick: channel slug (public chat, no auth needed)
KICK_CHANNEL=

# ============ Donations ============
# LivePix (https://docs.livepix.gg) — create an app in your LivePix account settings.
# OAuth2 client_credentials; used for webhook detail enrichment and webhook creation.
LIVEPIX_CLIENT_ID=
LIVEPIX_CLIENT_SECRET=
LIVEPIX_ACCESS_TOKEN=
# Optional: your LivePix account id — webhook payloads from other accounts are rejected.
LIVEPIX_USER_ID=

# Streamlabs (https://dev.streamlabs.com/docs/socket-api)
# Easiest: paste your Socket API Token (Dashboard → Settings → API Settings → API Tokens).
STREAMLABS_SOCKET_TOKEN=
# Or use an OAuth access token with donations.read + socket.token scopes;
# the socket token is then fetched automatically from /socket/token.
STREAMLABS_ACCESS_TOKEN=

# ============ Dashboard ============
LOG_LEVEL=INFO
# Host: 127.0.0.1 for local only (no PIN needed), 0.0.0.0 to access from phone/tablet
# (and to receive LivePix webhooks — put the dashboard behind a tunnel/proxy for that).
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8765
# PIN: set a 4+ digit PIN for dashboard access. If empty and host is 0.0.0.0,
# a random PIN is auto-generated each startup and shown in the terminal.
DASHBOARD_PIN=
